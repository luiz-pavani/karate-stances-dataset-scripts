# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# MATLAB
*.asv
*.mat~
slprj/
*.autosave

# Large data (use Figshare DOI for the full archive)
data/figshare/
data/raw/
data/processed/
*.csv.gz
*.parquet
*.h5

# Pipeline run outputs (regenerate with `python -m kds.batch`)
src/python/output/

# But keep the per-trial summary tables under data/processed_summary/
!data/processed_summary/
!data/processed_summary/**

# Raw per-trial time-series CSVs (regenerate with `python -m kds.export_timeseries`)
# The full per-trial archive lives on Figshare (DOI 10.6084/m9.figshare.32288943);
# only the schema README is tracked here so users know what the layout looks like.
data/timeseries_raw/*.csv
data/timeseries_raw/static/*.csv

# Raw per-trial kinetic CSVs (regenerate with `python -m kds.export_kinetic_timeseries`)
# Same rationale as the kinematic archive: heavy data lives on Figshare.
# The QC report and plate-corners table are small and kept tracked.
data/timeseries_kinetic_raw/ID*.csv
data/timeseries_kinetic_raw/static/*.csv

# Figures (regenerated)
figures/_generated/
*.tmp.pdf

# Local notes
notes_local/
TODO.local.md
